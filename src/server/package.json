{
  "name": "openglimpse",
  "version": "1.0.0",
  "description": "OpenGlimpse is a webapp that integrates AI to allow for quick registration and verification for event registration",
  "main": "index.js",
  "scripts": {
    "dev": "node modules/facial_recog/startFaceNet.js",
    "dev:all": "concurrently -n node,react \"node index.js\" \"cd ../client && npm run dev\"",
    "db:test": "node database/db.cjs",
    "start": "node index.js",
    "seed": "node ../../tests/seed.js",
    "test:sync": "node --test tests/server-replay.test.cjs",
    "test:python": "node ../../tests/test-endpoints.js",
    "test:ryan": "node ../../tests/ryan/test-ryan-endpoints.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenGlimpseAI/OpenGlimpse.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/OpenGlimpseAI/OpenGlimpse/issues"
  },
  "homepage": "https://github.com/OpenGlimpseAI/OpenGlimpse#readme",
  "dependencies": {
    "concurrently": "^9.2.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "groq-sdk": "^1.5.0",
    "node": "^22.22.3",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.3",
    "websocket": "^1.0.35"
  }
}
