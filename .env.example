# Supabase connection string (takes precedence over DB_* below)
DATABASE_URL=
DB_NAME=openglimpse
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
PORT=3001
# Deployment URLs — only consumed in non-dev runs (Vercel build / Render start)
CLIENT_URL=https://your-frontend.vercel.app
VITE_API_URL=https://your-backend.onrender.com
VITE_SOCKET_URL=https://your-backend.onrender.com
VITE_CHAT_SERVER_URL=https://your-backend.onrender.com
PYTHON_SERVER_URL=https://your-python-service.onrender.com
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
VITE_CHATBOT_TRIGGER=@assistant
